{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hue Deck",
  "mainBinaryName": "hue-deck",
  "version": "1.1.0",
  "identifier": "io.github.cc666debug.huedeck",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Hue lights, scenes and desktop shortcuts",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
